# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Python Virtual Environments & Cache
venv/
backend/venv/
.venv/
__pycache__/
*.py[cod]
*$py.class

# Build Output
dist/
backend/dist/
frontend/dist/
build/

# Environment files (Never commit real credentials)
.env
.env.local
.env.*.local
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example
!frontend/.env.forecasting
!frontend/.env.production
!frontend/.env.sales

# Uploads & Temporary files
backend/uploads/*
!backend/uploads/.gitkeep
!backend/uploads/**/.gitkeep
tmp/
temp/
scratch/
frontend/scratch/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
